    {
        "id": "fa707eba3d4fc904",
        "type": "comment",
        "z": "471b8388549842f6",
        "name": "topics",
        "info": "Arduino vers Node-RED : heart/sensor/raw, JSON {\"bpm\":72,\"spo2\":98,\"temp\":31.5} toutes les 4 s (bpm et spo2 à -1 quand il n'y a pas de mesure)\nNode-RED vers Arduino : heart/display/bpm, BPM lissé (moyenne des 5 dernières mesures valides)",
        "x": 200,
        "y": 40,
        "wires": []
    },
    {
        "id": "8d1beddb3b246f69",
        "type": "mqtt in",
        "z": "471b8388549842f6",
        "name": "",
        "topic": "heart/sensor/raw",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "hm_broker",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 150,
        "y": 120,
        "wires": [
            [
                "fbfaf83a525948bc"
            ]
        ]
    },
    {
        "id": "fbfaf83a525948bc",
        "type": "function",
        "z": "471b8388549842f6",
        "name": "décoder le JSON",
        "func": "const p = msg.payload;\nif (typeof p !== 'object' || p === null) return [null, null, null, null, null, null];\n\nconst bpm = Number(p.bpm);\nconst spo2 = Number(p.spo2);\nconst temp = Number(p.temp);\n\nconst bpmOk = bpm >= 30 && bpm <= 220;\nconst spo2Ok = spo2 > 0 && spo2 <= 100;\nconst valide = bpmOk && spo2Ok;\n\nif (valide) flow.set('detecte', true);\nconst detecte = flow.get('detecte') ?? false;\n\n// moyenne des 5 dernieres mesures valides, renvoyee a l'Arduino\nlet hist = flow.get('hist_bpm') ?? [];\nif (valide) {\n    hist.push(bpm);\n    if (hist.length > 5) hist.shift();\n} else {\n    hist = [];\n}\nflow.set('hist_bpm', hist);\nconst lisse = hist.length ? Math.round(hist.reduce((a, b) => a + b, 0) / hist.length) : null;\n\n// memes seuils que le code de la carte\nconst normal = valide && bpm >= 60 && bpm <= 100 && spo2 >= 95;\n\nlet signal;\nif (valide) signal = 'Signal capteur : OK';\nelse if (detecte) signal = 'Signal capteur : PERDU (alarme sur la carte)';\nelse signal = 'Signal capteur : en attente du doigt';\n\nlet rythme;\nif (!valide) rythme = 'Pas de mesure';\nelse if (normal) rythme = 'Rythme normal';\nelse rythme = 'Rythme anormal (' + bpm + ' bpm, SpO2 ' + spo2 + ' %)';\n\nreturn [\n    bpmOk ? { topic: 'BPM mesuré', payload: bpm } : null,\n    (valide && lisse !== null) ? { topic: 'BPM lissé', payload: lisse } : null,\n    spo2Ok ? { topic: 'SpO2', payload: spo2 } : null,\n    (!isNaN(temp) && temp > -40 && temp < 120) ? { topic: 'Température', payload: temp } : null,\n    { payload: signal },\n    { payload: rythme }\n];",
        "outputs": 6,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 120,
        "wires": [
            [
                "2e64ca88201606c6",
                "90c7be9ff80af2d7"
